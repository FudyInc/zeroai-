[Unit]
Description=ZeroAI — revisa que todo esté vivo y avisa si no
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/diego/zeroai
ExecStart=/usr/bin/python3 /home/diego/zeroai/scripts/revisar-salud.py
# Devuelve 1 cuando hay fallas: eso es información, no un error del timer.
SuccessExitStatus=0 1
