[Unit]
Description=ZeroAI backend (uvicorn, api:app)
After=network.target

[Service]
Type=simple
User=diego
WorkingDirectory=/home/diego/zeroai
ExecStart=/usr/bin/python3 -m uvicorn api:app --host 0.0.0.0 --port 8800 --log-level warning
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
