# Copy to .env (gitignored). Cada switch es independiente — ver docs/GO-LIVE.md.

# (a) Motor real — LOCAL (gratis, Ollama/vLLM): con esto el CLI y la API dejan el mock solos.
LOCAL_MODEL=
LOCAL_MODEL_URL=http://localhost:11434/v1
# ... o NUBE (pago, solo con --live explícito en el CLI):
ANTHROPIC_API_KEY=

# Discovery de leads: web = DuckDuckGo real (sin key, default en la API) · none = mock/LLM
DISCOVER=web

# (b) Envío real (sin OUTBOX_LIVE=1 nada sale, aunque haya credenciales)
OUTBOX_LIVE=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Bandeja real (detección de respuestas por IMAP)
INBOX_LIVE=
IMAP_HOST=
IMAP_USER=
IMAP_PASS=

# (c) WhatsApp Business API (Meta) - obtener en developers.facebook.com
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_URL=

# Alternativa local sin Cloud API. Solo responde mensajes entrantes.
# Genera un secreto aleatorio de 32+ caracteres y úsalo en el backend y el puente.
WHATSAPP_PROVIDER=meta
WHATSAPP_WEB_BRIDGE_TOKEN=
WHATSAPP_WEB_BRIDGE_URL=http://127.0.0.1:8810
WHATSAPP_WEB_CLIENT_PORTS={}
DEFAULT_INBOUND_CLIENT_ID=zeroai
DEFAULT_INBOUND_WHATSAPP_NUMBER=56964537891
WHATSAPP_WEB_BACKEND_URL=http://127.0.0.1:8800/api/webhooks/whatsapp-web
WHATSAPP_WEB_CHROME=

# Suspende avisos internos al WhatsApp del dueño sin apagar las respuestas a leads.
OWNER_WHATSAPP_PAUSED=0

# CRM/estado en la nube (Supabase) — si están, deja de usarse crm.json/state.json
SUPABASE_URL=
SUPABASE_KEY=
